# -- Providers (need at least one; router fails over in OSIRIS_PROVIDERS order) --
# All of these have real free tiers. More keys = more resilience.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Free key: https://cloud.cerebras.ai (fastest 70B inference anywhere)
CEREBRAS_API_KEY=
# Free key: https://console.mistral.ai (La Plateforme -> API keys, pick free tier)
MISTRAL_API_KEY=
# Free key: https://openrouter.ai/keys (works with the :free model pool)
OPENROUTER_API_KEY=
# GitHub PAT with "Models: read" permission -> free gpt-4o-mini via GitHub Models
GITHUB_MODELS_TOKEN=
# Optional paid fallback
OPENAI_API_KEY=
# Ollama is auto-detected if running locally (no key needed; best pulled model auto-picked)

# Router priority (comma-separated). Unconfigured providers are skipped.
# OSIRIS_PROVIDERS=gemini,groq,ollama,openai

# Memory embeddings spend Gemini quota (1-3 calls/turn). Set off to save the
# quota for chat; recall falls back to keyword search.
# OSIRIS_EMBEDDINGS=on

# Per-provider model overrides (defaults shown)
# OSIRIS_CHAT_MODEL=gemini-2.5-flash
# OSIRIS_GROQ_MODEL=llama-3.3-70b-versatile
# OSIRIS_OLLAMA_MODEL=qwen2.5:7b
# OSIRIS_OPENAI_MODEL=gpt-4o-mini

# -- Integrations --
# Optional — enables the GitHub tools. Fine-grained PAT with Issues read/write:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional — Discord channel webhook (channel settings → Integrations → Webhooks).
# Enables the discord_send tool + daemon reminders mirrored to Discord.
DISCORD_WEBHOOK_URL=

# -- Local machine access --
# Folders the fs_* and git_* tools may touch (semicolon-separated).
# Default: your Desktop (incl. OneDrive Desktop).
# OSIRIS_ALLOWED_DIRS=C:\Users\you\OneDrive\Desktop

# Commit identity for git_commit (else your global git config is used)
# OSIRIS_GIT_NAME=
# OSIRIS_GIT_EMAIL=

# Silences the startup note that appears when this project folder itself is
# inside a OneDrive-synced path (osiris.db/credentials.json/token.json/
# workspace/ sync to the cloud there even though they're git-ignored).
# OSIRIS_ACK_ONEDRIVE=1
